@{
    ViewData["Title"] = "Index";
    Layout = "_AdminLayout";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body bg-primary">
            <h4 class="card-title">About List</h4>

            <div class="table-responsive">
                <table class="table" id="aboutTable">
                    <thead>
                    <tr>
                        <th scope="col-sm-3">#</th>
                        <th scope="col-sm-3">Title</th>
                        <th scope="col-sm-3">SubDescription</th>
                        <th scope="col-sm-3">Update</th>
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@*modal *@

<div class="modal fade" id="about-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title" id="exampleModalLabel">Edit About</h5>
                <button onclick="closeModal()" type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body bg-default">
                <form>
                    <div class="form-group">
                        <label for="aboutTitle" class="col-form-label">Title:</label>
                        <input hidden type="text" class="form-control" id="aboutId">
                        <input type="text" class="form-control" id="aboutTitle">
                    </div>
                    <div class="form-group">
                        <label for="aboutSubDescription" class="col-form-label">SubDescription:</label>
                        <input type="text" class="form-control" id="aboutSubDescription">
                    </div>
                    <div class="form-group">
                        <label for="aboutDetails" class="col-form-label">Details:</label>
                        <textarea rows="10" class="form-control" id="aboutDetails"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button onclick="closeModal()" type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button onclick="updateFeature(this)" data-id="" type="button" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>


<script src="~/lib/jquery/jquery-3.7.1.min.js"></script>

<script>
    var about = null;
    $(document).ready( function (){
        $("#aboutTable").DataTable({
            "dom": "Tit",
            columnDefs: [{
                "defaultContent": "*",
                "targets":"_all"
            }],
            "responsive": true,
            "languages": {
                "emptyTable": "Gösterilecek veri yok",
                "processing": "Veriler yükleniyor",
                "sInfo": "<span class='text-white'>_TOTAL_ kayıttan _START_-_END_ arasındaki kayıtlar gösteriliyor</span>",
                "sLoadingRecords": "Yükleniyor...",
                "sZeroRecords": "Eşleşen Kayıt bulunamadı",
                "oAria": {
                    "sSortAscending": ": artan sütun sıralamasını aktifleştir",
                    "sSortDescending": ": azalan sütun sıralamasını aktifleştir"
                }
            },
            
        });
        refreshTable();
        
    })
    
</script>

<script>
    
    function refreshTable(){
        // controller tarafı bitti viewda about entity si gösterilmesi kaldı.
        $.ajax({
            url: "@Url.Action("GetAbout","About")",
            type: 'GET',
            success: function (item){
                var table = $("#aboutTable").DataTable();
                about = item.about;
                var rows = table.row.add([
                    item.about.aboutId,
                    item.about.title,
                    item.about.subDescription,
                    '<button onclick="openModal(this)" data-id="'+item.about.id+'" class="btn btn-danger">Update</button>',
                ]).draw();
            },
            error: function (error) {
                alert("There was an error updating data "+error);
                
            }
        })
        
    }
    
    // güncelleme fonk
    
    // modal açma fonk
    function openModal(){
    
        setModal(about)
        
        $("#about-modal").modal('show');
    }
    
    //Modal kapama fonk
    function closeModal(){
        $("#about-modal").modal('hide');
    }

    // modal temizleme 
    function clearModal(){
        $("#about-modal #aboutId").val("");
        $("#about-modal #aboutTitle").val("");
        $("#about-modal #aboutSubDescription").val("");
        $("#about-modal #aboutDetails").val("");
    }

    // modal ayarlama
    function setModal(data){
        // element içlerine gelen veriyi ayarlıcam
        $("#about-modal #aboutId").val(data.aboutId);
        $("#about-modal #aboutTitle").val(data.title);
        $("#about-modal #aboutSubDescription").val(data.subDescription);
        $("#about-modal #aboutDetails").val(data.details);
    }
    
    
</script>